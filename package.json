{
  "name": "portlens",
  "version": "0.1.0",
  "private": true,
  "description": "A safe Windows port and process workbench",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=dist/preload/index.cjs --external:electron && node scripts/copy-assets.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest --config vitest.config.ts",
    "test:e2e": "npm run build && playwright test",
    "diagnostic:ports": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File src/main/system/scripts/get-port-snapshot.ps1",
    "smoke:win": "powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File scripts/windows-smoke.ps1 -LaunchApp",
    "package:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron-store": "^10.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
